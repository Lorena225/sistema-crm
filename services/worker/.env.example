# Worker (Railway / Render) — Etapa 2
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Chave de criptografia de credenciais (32 bytes).
# Gerar com: openssl rand -base64 32
# Nunca commitar o valor real.
ENCRYPTION_KEY=

# Segredo de assinatura da fonte de webhook simulada (opcional em dev).
WEBHOOK_SIMULADO_SECRET=
