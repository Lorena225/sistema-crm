# =====================================================================
# Kommo++ VirtruvIA — contrato de ambiente (Etapa 1)
# Copie para .env.local (web) / .env (worker). NUNCA comite valores reais.
# =====================================================================

# --- Supabase: publico, seguro no browser -----------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# --- Supabase: SOMENTE server-side. Nunca prefixar com NEXT_PUBLIC_ ---
# Usada apenas nas rotas administrativas de reseller_admin e no worker.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Worker (Railway/Render) ------------------------------------------
PORT=8080
WORKER_PUBLIC_URL=https://<worker>.up.railway.app
NODE_ENV=development
LOG_LEVEL=info

# Criptografia de credenciais persistidas (32 bytes).
# Gerar com: openssl rand -base64 32
ENCRYPTION_KEY=

# Segredo de assinatura da fonte de webhook simulada (opcional em dev).
WEBHOOK_SIMULADO_SECRET=

# --- Twilio (BSP do WhatsApp) — Etapa 5 --------------------------------
# Conta MASTER da VirtruvIA. Usada apenas para criar subcontas por cliente.
# Somente Account SID e Auth Token: login e senha do Console Twilio nunca
# devem ser pedidos, aceitos nem armazenados.
TWILIO_MASTER_ACCOUNT_SID=
TWILIO_MASTER_AUTH_TOKEN=
