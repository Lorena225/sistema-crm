# Kommo++ web (Next.js / Vercel) — Etapa 1
# Copie para .env.local. NUNCA comite valores reais.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# SOMENTE server-side (rotas administrativas de reseller_admin).
# Nao prefixar com NEXT_PUBLIC_ em nenhuma hipotese.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
